# Frontend build config for Cloudflare Pages.
# Copy to `.env.production` before `npm run build`, or set these as
# Environment Variables in the Cloudflare Pages dashboard (Build settings).
#
# On Pages there is NO Vite dev proxy — the SPA must call the backend by its
# absolute Cloudflare Tunnel hostname.

# VITE_API_URL: inclut le préfixe /api/v1 (axios baseURL)
VITE_API_URL=https://api.votredomaine.com/api/v1
# VITE_WS_URL: ORIGINE SEULE (le code ajoute /ws/events lui-même)
VITE_WS_URL=wss://api.votredomaine.com
