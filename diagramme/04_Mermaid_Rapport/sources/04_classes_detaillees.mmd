namespace PipelineIoTEtIA {
  class Sensor {
    +int id
    +int unit_id
    +string sensor_type
    +string sensor_id
    +bool is_active
    +datetime last_seen
    +json metadata_
  }

  class TelemetryRecord {
    +int id
    +int unit_id
    +json metrics
    +string source
    +datetime timestamp
  }

  class CVEvent {
    +int id
    +int unit_id
    +string object_class
    +float confidence
    +string severity
    +string thumbnail_url
    +json frame_metadata
    +datetime timestamp
  }

  class Anomaly {
    +int id
    +int unit_id
    +string anomaly_type
    +string severity
    +float isolation_score
    +json rules_triggered
    +json feature_contributions
    +datetime timestamp
  }

  class Alert {
    +int id
    +int unit_id
    +string alert_type
    +text message
    +string severity
    +bool is_resolved
    +datetime timestamp
    +datetime resolved_at
  }

  class Recommendation {
    +int id
    +int unit_id
    +int alert_id
    +text probable_cause
    +text recommendation_text
    +string urgency_level
    +float confidence_score
    +bool is_actioned
    +datetime timestamp
  }

  class DiagnosticHistory {
    +int id
    +int user_id
    +string category
    +text image_url
    +json detections
    +json chat_log
    +datetime timestamp
  }

  class MLFeedback {
    +int id
    +int cv_event_id
    +int user_id
    +string original_label
    +string corrected_label
