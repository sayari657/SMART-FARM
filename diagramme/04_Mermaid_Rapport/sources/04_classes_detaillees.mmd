    +int id
    +string email
    +string phone_number
    +string role
    +string plan
    +bool is_active
    +datetime created_at
  }

  class FarmOwner {
    +int farm_id
    +int owner_id
    +datetime added_at
  }

  class WorkerAssignment {
    +int worker_id
    +int farm_id
    +string pin_code
    +bool is_active
    +datetime assigned_at
  }

  class WorkerTask {
    +int id
    +int farm_id
    +int worker_id
    +int animal_id
    +string title
    +string priority
    +string status
    +datetime due_date
  }

  class WorkerReport {
