# ── Smart Farm AI — Environment Template ──────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/smartfarm
USE_SQLITE=false

# Security
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# AI / LLM
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Notifications
WHATSAPP_TOKEN=REPLACE_WITH_YOUR_META_TOKEN
WHATSAPP_PHONE_ID=REPLACE_WITH_YOUR_PHONE_ID
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your@email.com
SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD

# YOLO Model Paths (defaults resolve from ai_assets/)
# YOLO_BEE_PATH=/custom/path/to/bee/best.pt
# YOLO_FIRE_PATH=/custom/path/to/fire/best.pt

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Cloud Storage (for DVC remote)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=

# Feature flags
LITE_MODE=false
DEBUG=false

# MLOps
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
RETRAIN_THRESHOLD=50
PSI_WARNING=0.1
PSI_CRITICAL=0.2

# DVC Remote Storage (S3-compatible)
# AWS_ENDPOINT_URL=https://s3.yourendpoint.com
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# Web Push VAPID (generate: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=your@email.com

# Stripe Billing (test mode: sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# IoT telemetry ingest rate limit (per source IP)
IOT_TELEMETRY_RATE_LIMIT=60/minute

# Cloudflare Vectorize RAG Worker (serverless RAG)
RAG_WORKER_URL=
# Cloudflare R2 public base URL for YOLO models (lazy download)
R2_MODELS_BASE_URL=
# Telegram bot alerts (no 24h limit, unlike WhatsApp)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
