# ╔══════════════════════════════════════════════════════════════╗
# ║  Smart Farm AI — Backend PRODUCTION Environment              ║
# ║  Copy to backend/.env and fill every CHANGE_ME value.        ║
# ║  Generate SECRET_KEY: python -c                              ║
# ║    "import secrets; print(secrets.token_hex(32))"            ║
# ║  NEVER commit backend/.env to git.                           ║
# ╚══════════════════════════════════════════════════════════════╝

# ── App ────────────────────────────────────────────────────────────────────────
PROJECT_NAME=Smart Farm AI
VERSION=3.0.0-Enterprise
DEBUG=false
LITE_MODE=false

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ── Database (PostgreSQL required in production) ───────────────────────────────
DATABASE_URL=postgresql+psycopg2://farmuser:CHANGE_ME_strong_password@db:5432/smart_farm
USE_SQLITE=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated, no trailing slash, no wildcards in production
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MQTT ───────────────────────────────────────────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=smart_farm

# ── AI / LLM ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY
OLLAMA_BASE_URL=http://ollama:11434
VISION_MODEL=llava:latest
DERJA_MODEL=wghezaiel/labess-7b-chat

# ── Vector DB (ChromaDB) ───────────────────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8001

# ── OTP: Gmail SMTP ────────────────────────────────────────────────────────────
# Enable 2FA on Gmail → Security → App passwords → generate one for "Mail"
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=CHANGE_ME_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── OTP: WhatsApp Cloud API ────────────────────────────────────────────────────
# developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=CHANGE_ME_meta_whatsapp_token
WHATSAPP_PHONE_ID=CHANGE_ME_phone_number_id
WHATSAPP_API_VERSION=v25.0

# ── External APIs ──────────────────────────────────────────────────────────────
TREFLE_API_TOKEN=CHANGE_ME_trefle_token
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# ── YOLO Model Paths (defaults resolve from ai_assets/ — override if needed) ──
# YOLO_BEE_PATH=/app/ai_assets/animal_weights/bee/final_export/best.pt
# YOLO_GOAT_PATH=/app/ai_assets/animal_weights/model goat cow/best.pt
# YOLO_COW_PATH=/app/ai_assets/animal_weights/model goat cow/best.pt
# YOLO_SHEEP_PATH=/app/ai_assets/animal_weights/model goat cow/best.pt
# YOLO_RABBIT_PATH=/app/ai_assets/animal_weights/Model_rabbit_YOLOv11/best.pt
# YOLO_GOAT_DISEASE_PATH=/app/ai_assets/animal_weights/Model_goat_YOLOv11/best.pt
# YOLO_CHICKEN_DISEASE_PATH=/app/ai_assets/animal_weights/Model_chicken_YOLOv11/best.pt
# YOLO_CHICKEN_DETECT_PATH=/app/ai_assets/animal_weights/Model_chicken_detection_YOLOv11/best.pt
# YOLO_COW_BEHAVIOR_PATH=/app/ai_assets/animal_weights/Model_cow_behavior_YOLOv11/best.pt
# YOLO_LEAVES_PATH=/app/ai_assets/plantations/Detection diseases Leaves/best.pt
# YOLO_OLIVE_PATH=/app/ai_assets/plantations/model olive-tree-diseases/best.pt
# YOLO_INSECTS_PATH=/app/ai_assets/plantations/model insects_final/best.pt
# YOLO_LEMON_PATH=/app/ai_assets/plantations/model lemon-leaf/best.pt
# YOLO_ORANGE_PATH=/app/ai_assets/plantations/Model orange-leaf/best.pt
# YOLO_PLANTDOC_PATH=/app/ai_assets/plantations/Model_plantdoc_YOLOv11/best.pt
# YOLO_FIRE_PATH=/app/ai_assets/Alert/model-fire-detection-and-smoke/best.pt
