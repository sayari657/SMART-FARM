# Smart Farm AI — Environment Configuration
# Copy this file to .env and fill in values before running

# ---- Application ----
PROJECT_NAME=Smart Farm AI
VERSION=3.0.0-Enterprise
API_V1_STR=/api/v1

# ---- JWT Security ----
SECRET_KEY=change_this_to_a_random_32_char_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_TTL_MINUTES=5

# Optional first-run owner account. Leave blank to disable automatic creation.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# ---- Database ----
# Format: postgresql+pg8000://user:password@host:port/dbname
DATABASE_URL=postgresql+pg8000://admin:password@localhost:5432/smart_farm

# ---- MQTT Broker ----
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=smart_farm

# ---- Redis (optional cache/pub-sub) ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend WebSocket (Recommendations page) ----
VITE_WS_URL=ws://localhost:8000

# ---- MLOps ----
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
RETRAIN_THRESHOLD=50
PSI_WARNING=0.1
PSI_CRITICAL=0.2

# ---- DVC Remote Storage (S3-compatible) ----
# AWS_ENDPOINT_URL=https://s3.yourendpoint.com
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# ---- Docker overrides (used in docker-compose.yml) ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=smart_farm

# Web Push VAPID (generate: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=your@email.com

# Stripe Billing (test mode: sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# IoT telemetry ingest rate limit (per source IP)
IOT_TELEMETRY_RATE_LIMIT=60/minute

# Cloudflare Vectorize RAG Worker (serverless RAG)
RAG_WORKER_URL=
# Cloudflare R2 public base URL for YOLO models (lazy download)
R2_MODELS_BASE_URL=
# Telegram bot alerts (no 24h limit, unlike WhatsApp)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
